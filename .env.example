LOCAL_MODE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

GEMINI_MODEL=

# Tiered model routing for Project Review -- independent of GEMINI_MODEL above,
# which is single-file Code Review's own setting.
PROJECT_REVIEW_FLASH_MODEL=gemini-2.5-flash
PROJECT_REVIEW_PRO_MODEL=gemini-2.5-pro
PROJECT_REVIEW_CONCURRENCY=8

EMBEDDING_MODEL=

VECTOR_SEARCH_INDEX=
VECTOR_SEARCH_ENDPOINT=

PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=

FIRESTORE_DATABASE=
HISTORICAL_BUCKET=

# Optional -- GitHub repo import. Leave unset and the feature 503s cleanly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
